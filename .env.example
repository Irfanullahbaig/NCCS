# App
AUTH_SECRET="replace-with-a-long-random-string"
# Keep this value stable across Vercel deploys so login Server Actions keep working.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-long-random-string"

# Supabase Postgres (Project Settings → Database → Connect)
# On Vercel, add these as Secret (not Config). Do not use NEXT_PUBLIC_ for database URLs.

# Shared transaction-mode pooler (IPv4, port 6543) — Next.js / Vercel runtime.
DATABASE_URL="postgresql://postgres.cafefxuxpswfuraaazdw:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Shared session-mode pooler (port 5432) — Prisma migrations only.
DIRECT_URL="postgresql://postgres.cafefxuxpswfuraaazdw:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase API (Project Settings → API Keys)
# Publishable keys may use NEXT_PUBLIC_ so the browser client can read them.
# On Vercel, add NEXT_PUBLIC_* variables as Config (not Secret).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SECRET_KEY="your-secret-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
