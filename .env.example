# App (required). Generate long random strings for production.
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-a-long-random-string"

# New Supabase project (Project Settings → Data API / API Keys).
# Set the same names in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* are Config (browser-safe). Secret keys are Secret (server-only).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Optional aliases if you copy keys with older names from the dashboard.
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-key"
