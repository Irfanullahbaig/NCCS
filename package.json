{
  "name": "nccs",
  "version": "0.1.0",
  "private": true,
  "description": "NCCS school management desktop app",
  "author": "NCCS",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.cjs",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "node --env-file=.env --env-file=.env.local --import tsx scripts/seed.ts",
    "db:backup": "node --env-file=.env --env-file=.env.local --import tsx scripts/backup-now.ts",
    "db:import": "node --env-file=.env --env-file=.env.local --import tsx scripts/import-snapshot.ts",
    "desktop": "electron .",
    "desktop:dev": "NCCS_DESKTOP_URL=http://localhost:3000 electron .",
    "desktop:win": "node scripts/desktop-build.cjs",
    "desktop:mac": "node scripts/desktop-build.cjs --mac"
  },
  "build": {
    "appId": "edu.nccs.desktop",
    "productName": "NCCS",
    "copyright": "NCCS",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json",
      "node_modules/bcryptjs/**/*"
    ],
    "afterPack": "./scripts/desktop-after-pack.cjs",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app-server/node_modules"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "desktop/icons"
    },
    "win": {
      "icon": "desktop/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "NCCS.exe"
    },
    "mac": {
      "icon": "desktop/icons/icon.icns",
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "NCCS.dmg",
      "title": "NCCS"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
